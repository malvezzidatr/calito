# ==========================================================================
# Banco de dados
# --------------------------------------------------------------------------
# A aplicação lê SOMENTE a DATABASE_URL (Prisma + @prisma/adapter-pg).
# Local: use o Postgres do docker-compose.
# Produção (Supabase): use a connection string do "Session pooler" e
# acrescente ?sslmode=require no final.
DATABASE_URL=postgresql://calito:calito@localhost:5432/calito

# Variáveis abaixo NÃO são lidas pela app — só configuram o container
# Postgres do docker-compose.yml pro ambiente local.
DB_USER=calito
DB_PASSWORD=calito
DB_NAME=calito
DB_PORT=5432

# ==========================================================================
# Runtime
# --------------------------------------------------------------------------
# NODE_ENV=production já vem setado na imagem Docker.
NODE_ENV=development
PORT=3000

# ==========================================================================
# IA (OpenAI)
# --------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TEMPERATURE=0.2

# 'true' usa a calculadora local de calorias/macros no lugar da IA.
USE_LOCAL_CALCULATOR=false

# ==========================================================================
# WhatsApp
# --------------------------------------------------------------------------
# Chave de 32 bytes em base64 pra cifrar WhatsappAuth.data em repouso (CS-123).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: perder essa chave torna a sessão salva ilegível (precisa reparear).
WHATSAPP_AUTH_ENCRYPTION_KEY=

# Token de acesso à página protegida que exibe o QR de pareamento no navegador.
# Gere um segredo longo e configure a mesma variável no Render.
WHATSAPP_QR_ACCESS_TOKEN=

# Opcional: quando o bot precisa parear, faz um POST com o QR pra esse URL
# (útil quando não dá pra ver o log do container).
ADMIN_WEBHOOK_URL=

# ==========================================================================
# Assinatura / Mercado Pago
# --------------------------------------------------------------------------
SUBSCRIPTION_PRICE_BRL=9.90
MP_ACCESS_TOKEN=
# URL pública que o Mercado Pago chama no pagamento — a mesma cadastrada no
# painel MP. Em produção: https://<seu-deploy>/webhooks/mercadopago
MP_WEBHOOK_URL=
# Segredo da assinatura do webhook (painel MP). Em produção é OBRIGATÓRIO:
# sem ele o webhook rejeita tudo (fail-closed, CS-124). Vazio só em dev/test.
MP_WEBHOOK_SECRET=
