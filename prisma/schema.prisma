generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INACTIVE
  ACTIVE
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  INTENSE
  VERY_INTENSE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

model User {
  id String @id @default(uuid())
  phone String @unique
  name String?
  status UserStatus @default(INACTIVE)
  onboarding_step String?
  subscription_id String?
  subscription_expires_at DateTime?
  trial_ends_at DateTime?

  weight Float?
  height Float?
  age Int?
  gender Gender?
  activity_level ActivityLevel?

  goal Goal?
  calorie_goal Int?
  protein_goal Int?
  carbs_goal Int?
  fat_goal Int?

  consent_given Boolean @default(false) 
  consent_date DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  meals Meal[]
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}
model Meal {
  id String @id @default(uuid())
  user_id String
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  meal_type MealType
  description String
  calories Int
  protein Float
  carbs Float
  fat Float
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
}

model WhatsappAuth {
  id String @id @default(uuid())
  type String
  name String
  data Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([type, name])
}

model EstimatedFood {
  id String @id @default(uuid())
  food_name String
  unit String
  calories Float
  protein Float
  carbs Float
  fat Float
  source String @default("ai_estimate")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([food_name, unit])
}

model ParsedMessageCache {
  id String @id @default(uuid())
  normalized_text String @unique
  foods Json
  meal_type String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}